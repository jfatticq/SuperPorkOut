    <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; align-items: center;">
        <ui:VisualElement style="align-items: center;">
            <ui:Label text="Super Pork-Out" name="GameTitleLabel" style="-unity-font-definition: url(&quot;project://database/Assets/ThirdParty/maanetorn/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 52px; left: auto; color: rgb(178, 116, 188); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); align-content: auto;" />
            <ui:Button text="Escape Now!!" name="StartButton" class="start-button mainmenu-button any-button" />
            <ui:Button text="Guide" name="GuideButton" class="guide-button mainmenu-button" />
            <ui:Button text="Settings" name="SettingsButton" class="mainmenu-button settings-button" />
            <ui:Button text="Credits" name="CreditsButton" class="mainmenu-button credits-button" style="background-image: url(&quot;project://database/Assets/ThirdParty/maanetorn/Farm%20Game%20UI%20-%20Simple%202D%20UI/Sprites/128x128/button_yellow_default_1.png?fileID=2800000&amp;guid=a18243c5d1204634aa8c2b11bd52162e&amp;type=3#button_yellow_default_1&quot;); -unity-text-align: middle-center;" />
            <ui:Button text="Go Back To Sleep" name="QuitButton" class="mainmenu-button quit-button" />
        </ui:VisualElement>
    </ui:VisualElement>
